{
  "title": "Live comparison metrics",
  "description": "Synthetic source dashboard for the isolated shared-sample lab. Target artifacts are produced only by migrator convert.",
  "layout_type": "ordered",
  "template_variables": [
    {
      "name": "host",
      "prefix": "host",
      "default": "*"
    }
  ],
  "widgets": [
    {
      "definition": {
        "type": "timeseries",
        "title": "Postgres connections",
        "requests": [
          {
            "response_format": "timeseries",
            "queries": [
              {
                "data_source": "metrics",
                "name": "a",
                "query": "avg:postgresql.connections{$host}"
              }
            ],
            "formulas": [
              {
                "formula": "a"
              }
            ]
          }
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Postgres fetched rows per second",
        "requests": [
          {
            "response_format": "timeseries",
            "queries": [
              {
                "data_source": "metrics",
                "name": "a",
                "query": "avg:postgresql.rows_fetched{$host}"
              }
            ],
            "formulas": [
              {
                "formula": "a"
              }
            ]
          }
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Redis used memory",
        "requests": [
          {
            "response_format": "timeseries",
            "queries": [
              {
                "data_source": "metrics",
                "name": "a",
                "query": "avg:redis.mem.used{$host}"
              }
            ],
            "formulas": [
              {
                "formula": "a"
              }
            ]
          }
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Nginx active connections",
        "requests": [
          {
            "response_format": "timeseries",
            "queries": [
              {
                "data_source": "metrics",
                "name": "a",
                "query": "sum:nginx.net.connections{$host}"
              }
            ],
            "formulas": [
              {
                "formula": "a"
              }
            ]
          }
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Redis RSS minus used memory",
        "requests": [
          {
            "response_format": "timeseries",
            "queries": [
              {
                "data_source": "metrics",
                "name": "a",
                "query": "avg:redis.mem.used{$host}"
              },
              {
                "data_source": "metrics",
                "name": "b",
                "query": "avg:redis.mem.rss{$host}"
              }
            ],
            "formulas": [
              {
                "formula": "b - a"
              }
            ]
          }
        ]
      }
    }
  ]
}
