[
  {
    "id": "dd-dash-postgres__postgresql_dashboard/w-0",
    "kind": "panel",
    "title": "Rows fetched / returned / inserted / updated (per sec)",
    "widget_type": "timeseries",
    "status": "bounded",
    "promql": [
      "avg (rate({otel_metric_name=\"postgresql.tup_fetched\"}[$__interval] anchored))",
      "avg (rate({otel_metric_name=\"postgresql.tup_returned\"}[$__interval] anchored))",
      "avg (rate({otel_metric_name=\"postgresql.tup_inserted\"}[$__interval] anchored))",
      "avg (rate({otel_metric_name=\"postgresql.tup_updated\"}[$__interval] anchored))"
    ],
    "rules": [
      "select.metric.mapped",
      "select.metric.approximate",
      "time.ddrate.plain.anchored",
      "space.agg",
      "widget.timeseries",
      "emit.certificate",
      "validate.preflight",
      "emit.id",
      "emit.single-item"
    ],
    "assumptions": [
      "A.align",
      "A.boundary",
      "A.no-reset",
      "A.regular-sampling",
      "A.same-samples",
      "A.var-default"
    ],
    "findings": [
      "bounded metric.approximate",
      "exact-under scope.var.free-form"
    ]
  },
  {
    "id": "dd-dash-postgres__postgresql_dashboard/w-1",
    "kind": "panel",
    "title": "Connections",
    "widget_type": "timeseries",
    "status": "bounded",
    "promql": [
      "avg by (db) (avg_over_time({otel_metric_name=\"postgresql.backends\"}[$__interval]))"
    ],
    "rules": [
      "select.metric.mapped",
      "select.metric.approximate",
      "time.rollup.default",
      "space.agg",
      "label.default",
      "widget.timeseries",
      "emit.certificate",
      "validate.preflight",
      "emit.id",
      "emit.single-item"
    ],
    "assumptions": [
      "A.align",
      "A.boundary",
      "A.tag-default",
      "A.var-default"
    ],
    "findings": [
      "bounded metric.approximate",
      "exact-under scope.var.free-form",
      "exact-under tag.unmapped"
    ]
  },
  {
