  {
    "id": "dd-dash-postgres__postgresql_dashboard/w-7",
    "kind": "panel",
    "title": "System memory",
    "widget_type": "timeseries",
    "status": "bounded",
    "promql": [
      "9.5367431640625e-7 * sum (avg_over_time({otel_metric_name=\"system.linux.memory.available\"}[$__interval]))",
      "9.5367431640625e-7 * sum (avg_over_time({otel_metric_name=\"system.memory.limit\"}[$__interval])) - 9.5367431640625e-7 * sum (avg_over_time({otel_metric_name=\"system.linux.memory.available\"}[$__interval]))"
    ],
    "rules": [
      "select.metric.mapped",
      "select.metric.approximate",
      "time.rollup.default",
      "select.metric.transform",
      "space.agg",
      "arith.same-groups",
      "widget.timeseries",
      "emit.certificate",
      "validate.preflight",
      "emit.id",
      "emit.single-item"
    ],
    "assumptions": [
      "A.align",
      "A.boundary",
      "A.var-default"
    ],
    "findings": [
      "bounded metric.approximate",
      "exact-under scope.var.free-form"
    ]
  },
