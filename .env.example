# Proposed variable names. Implementation must explicitly load .env or use shell env.
# Never put real values in this committed template.
DD_SITE=datadoghq.eu
DD_API_KEY=
# Queries accept a PAT (either name); ingestion still requires DD_API_KEY.
DATADOG_PAT=
DD_BEARER_TOKEN=
# Only needed for queries when no PAT is configured.
DD_APP_KEY=

# Copy the API base URL from your Dash0 organization's Settings > Endpoints.
# EU example only; use your organization's actual endpoint.
DASH0_API_URL=https://api.eu-west-1.aws.dash0.com
DASH0_AUTH_TOKEN=
DASH0_DATASET=default

# Optional voice copilot in the local UI (ElevenLabs agent "Migration Copilot").
# The key stays in the backend; the browser only receives a short-lived signed URL.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Optional: the guided tour's voice. Default is the agent's own voice and eleven_multilingual_v2.
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=

# On-demand live comparison: explicit OTLP/HTTP base endpoint from Dash0 Settings.
# No /v1/metrics suffix. --dash0-dataset selects ingestion, querying and publication.
DASH0_OTLP_ENDPOINT=https://ingress.eu-west-1.aws.dash0.com
