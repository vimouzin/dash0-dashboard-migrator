    "panels": {
      "widget-0-0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "",
            "name": ""
          },
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "This dashboard shows latency information and slow query counts that summarize your Redis master's performance, as well as memory metrics to help you manage your Redis instance.\n\n##### [Official Datadog Redis documentation ↗](https://docs.datadoghq.com/integrations/redisdb/)"
            }
          },
          "queries": []
        }
      },
      "widget-0-1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "",
            "name": ""
          },
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "**Our 3-part blog series**\n\n\n[How to monitor Redis performance metrics&nbsp;↗](https://www.datadoghq.com/blog/how-to-monitor-redis-performance-metrics/)\n\n[Collecting Redis metrics&nbsp;↗](https://www.datadoghq.com/blog/how-to-collect-redis-metrics/)\n\n[Monitoring Redis with Datadog&nbsp;↗](https://www.datadoghq.com/blog/monitor-redis-using-datadog/)"
            }
          },
          "queries": []
        }
      },
      "widget-1-0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "",
            "name": "Hit rate"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "mean"
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "(avg (rate({otel_metric_name=\"redis.keyspace.hits\", otel_metric_type=\"sum\", host_name=~\"^($host)$\"}[$__rate_interval]))) / ((avg (rate({otel_metric_name=\"redis.keyspace.hits\", otel_metric_type=\"sum\", host_name=~\"^($host)$\"}[$__rate_interval]))) + (avg (rate({otel_metric_name=\"redis.keyspace.misses\", otel_metric_type=\"sum\", host_name=~\"^($host)$\"}[$__rate_interval])))) * 100"
                  }
                }
              }
            }
          ]
        }
      },
      "widget-1-1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "",
            "name": "Blocked clients"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "max"
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum ({otel_metric_name=\"redis.clients.blocked\", otel_metric_type=\"sum\", host_name=~\"^($host)$\"})"
                  }
                }
              }
            }
          ]
        }
      },
      "widget-1-2": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "",
            "name": "Redis keyspace"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "max"
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum ({otel_metric_name=\"redis.db.keys\", otel_metric_type=\"gauge\", host_name=~\"^($host)$\"})"
                  }
                }
              }
            }
          ]
        }
      },
      "widget-1-3": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "",
            "name": "Unsaved changes"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "mean"
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum ({otel_metric_name=\"redis.rdb.changes_since_last_save\", otel_metric_type=\"sum\", host_name=~\"^($host)$\"})"
                  }
                }
              }
            }
          ]
        }
      },
      "widget-1-5": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "",
            "name": ""
          },
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "This metric is only available when the connection between the primary and its replica has been lost. Ideally, this value should never exceed zero—the primary and the replica should be in constant communication to ensure the replica is not serving stale data."
            }
          },
          "queries": []
        }
      },
      "widget-2-1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "",
            "name": ""
          },
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "Latency measures the **time between a client request and the server response**, and monitoring it enables you to detect changes in Redis performance. The single-threaded nature of Redis means that a long response time for one request increases the latency for all subsequent requests, leading to serious bottlenecks."
            }
          },
          "queries": []
        }
      },
      "widget-2-5": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "",
            "name": "Average CPU usage"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "avg (rate({otel_metric_name=\"redis.cpu.time\", otel_metric_type=\"sum\", host_name=~\"^($host)$\", state=\"sys\"}[$__rate_interval]))"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "avg (rate({otel_metric_name=\"redis.cpu.time\", otel_metric_type=\"sum\", host_name=~\"^($host)$\", state=\"user\"}[$__rate_interval]))"
                  }
                }
              }
            }
          ]
        }
      },
