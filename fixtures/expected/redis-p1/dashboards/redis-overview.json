      "widget-3-1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "",
            "name": ""
          },
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "Memory usage is a crucial performance factor. If `used_memory > total available system memory`, the OS will begin swapping old/unused sections of memory and writing them to disk. Writing or reading from disk is up to 100,000 times slower than writing or reading from memory (0.1 µs for memory vs. 10 ms for disk)."
            }
          },
          "queries": []
        }
      },
