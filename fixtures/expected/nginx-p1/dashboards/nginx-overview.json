{
  "kind": "Dashboard",
  "metadata": {
    "name": "nginx-overview",
    "project": "datadog-migration"
  },
  "spec": {
    "display": {
      "description": "This dashboard provides a high-level overview of your NGINX infrastructure, so you can see aggregated throughput and activity metrics from all your servers and spot issues quickly. Further reading on NGINX monitoring:\n\n- [Datadog's guide to key NGINX metrics](https://www.datadoghq.com/blog/how-to-monitor-nginx/)\n\n- [How to collect NGINX metrics using built-in tools](https://www.datadoghq.com/blog/how-to-collect-nginx-metrics/)\n\n- [How to monitor NGINX with Datadog](https://www.datadoghq.com/blog/how-to-monitor-nginx-with-datadog/)\n\n- [Datadog's NGINX integration docs](https://docs.datadoghq.com/integrations/nginx/)\n\nClone this template dashboard to make changes and add your own graph widgets.\n\nMigration remarks: TIMEPIN (see panel descriptions).",
      "name": "NGINX - Overview"
    },
    "duration": "1h",
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "New group"
          },
          "items": [
            {
              "content": {
                "$ref": "#/spec/panels/widget-0-0"
              },
              "height": 6,
              "width": 6,
              "x": 0,
              "y": 0
            },
            {
              "content": {
                "$ref": "#/spec/panels/widget-0-1"
              },
              "height": 6,
              "width": 6,
              "x": 6,
              "y": 0
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Activity Summary"
          },
          "items": [
            {
              "content": {
                "$ref": "#/spec/panels/widget-1-2"
              },
              "height": 3,
              "width": 6,
              "x": 0,
              "y": 3
            },
            {
              "content": {
                "$ref": "#/spec/panels/widget-1-3"
              },
              "height": 3,
              "width": 6,
              "x": 6,
              "y": 3
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Anomaly Detection"
          },
          "items": [
            {
              "content": {
                "$ref": "#/spec/panels/widget-2-1"
              },
              "height": 6,
              "width": 8,
              "x": 16,
              "y": 0
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Logs"
          },
          "items": [
            {
              "content": {
                "$ref": "#/spec/panels/widget-3-0"
              },
              "height": 6,
              "width": 12,
              "x": 0,
              "y": 0
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Requests"
          },
          "items": [
            {
              "content": {
                "$ref": "#/spec/panels/widget-4-0"
              },
              "height": 6,
              "width": 4,
              "x": 0,
              "y": 0
            },
            {
              "content": {
                "$ref": "#/spec/panels/widget-4-2"
              },
              "height": 6,
              "width": 4,
              "x": 8,
              "y": 0
            },
            {
              "content": {
                "$ref": "#/spec/panels/widget-4-3"
              },
              "height": 6,
              "width": 4,
              "x": 0,
              "y": 6
            },
            {
              "content": {
                "$ref": "#/spec/panels/widget-4-4"
              },
              "height": 6,
              "width": 8,
              "x": 4,
              "y": 6
            },
            {
              "content": {
                "$ref": "#/spec/panels/widget-4-6"
              },
              "height": 6,
              "width": 2,
              "x": 10,
              "y": 12
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Connections "
          },
          "items": [
            {
              "content": {
                "$ref": "#/spec/panels/widget-5-1"
              },
              "height": 6,
              "width": 6,
              "x": 6,
              "y": 0
            },
            {
              "content": {
                "$ref": "#/spec/panels/widget-5-2"
              },
              "height": 3,
              "width": 12,
              "x": 0,
              "y": 6
            }
          ]
        }
      }
    ],
    "panels": {
      "widget-0-0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "",
            "name": ""
          },
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "This dashboard provides a high-level view of your NGINX deployments and troubleshoot resource issues, including:\n- A high-level view of combined end-user activity\n- How often your servers are failing to process seemingly valid requests\n- How long your servers are taking to process client requests"
            }
          },
          "queries": []
        }
      },
      "widget-0-1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "",
            "name": ""
          },
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "#### Further reading on the NGINX integration:\n- [Datadog's guide to  key NGINX metrics](https://www.datadoghq.com/blog/how-to-monitor-nginx/)\n- [Collecting metrics with NGINX monitoring tool](https://www.datadoghq.com/blog/how-to-collect-nginx-metrics/)\n- [How to monitor NGINX with Datadog](https://www.datadoghq.com/blog/how-to-monitor-nginx-with-datadog/)\n- [Datadog's NGINX integration docs](https://docs.datadoghq.com/integrations/nginx/?tab=host#)\n[If you're using NGINX Plus, check out our docs here](https://docs.datadoghq.com/integrations/nginx/?tab=host#nginx-plus)\n"
            }
          },
          "queries": []
        }
      },
      "widget-1-2": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "",
            "name": ""
          },
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "The number of connections that have been dropped is equal to the difference between accepted and handled connections.\n"
            }
          },
          "queries": []
        }
      },
      "widget-1-3": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "",
            "name": ""
          },
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "This check returns CRITICAL if the Agent is unable to connect to and collect metrics from the monitored Nginx instance"
            }
          },
          "queries": []
        }
      },
      "widget-2-1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "",
            "name": ""
          },
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "Watchdog proactively detects and surfaces anomalous behavior across your services and infrastructure to help you catch issues early.\n\nGet notified of new Watchdog alerts by creating a Watchdog Monitor [here](https://app.datadoghq.com/monitors#create/watchdog)."
            }
          },
          "queries": []
        }
      },
      "widget-3-0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "",
            "name": ""
          },
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "NGINX error metrics tell you how often your servers are returning errors instead of producing useful work. You can monitor the errors through Datadog's logging capabilities. \n\n- Client errors are represented by 4xx status codes, server errors with 5xx status codes."
            }
          },
          "queries": []
        }
      },
      "widget-4-0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "",
            "name": "Requests per second"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "mean"
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "avg (max by (host_name) (rate({otel_metric_name=\"nginx.requests\", otel_metric_type=\"sum\"}[$__rate_interval])))"
                  }
                }
              }
            }
          ]
        }
      },
      "widget-4-2": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "",
            "name": ""
          },
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "Grouping by hosts allows you to easily identify where in your environment an issue could be occurring. \n\n🟢 Green : low number of requests\n\n🟠 Orange: high number of requests"
            }
          },
          "queries": []
        }
      },
      "widget-4-3": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "",
            "name": ""
          },
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "Sampling your request data with a fixed time interval provides you with the number of requests you’re receiving per unit of time—often minutes or seconds.\n\nMonitoring this metric can alert you to spikes in incoming web traffic, whether legitimate or nefarious, or sudden drops in traffic, which are usually indicative of problems"
            }
          },
          "queries": []
        }
      },
      "widget-4-4": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "[TIMEPIN] Datadog pinned this widget to its own time frame; Perses and Dash0 panels have no per-panel time range, so it follows the dashboard time picker. Values reduced over that range, including query values and rankings, can change.",
            "name": "Requests: reading, writing, waiting"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum (max by (host_name) ({otel_metric_name=\"nginx.connections_current\", otel_metric_type=\"sum\", host_name=~\"^($Host)$\", state=\"reading\"}))"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum (max by (host_name) ({otel_metric_name=\"nginx.connections_current\", otel_metric_type=\"sum\", host_name=~\"^($Host)$\", state=\"writing\"}))"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum (max by (host_name) ({otel_metric_name=\"nginx.connections_current\", otel_metric_type=\"sum\", host_name=~\"^($Host)$\", state=\"waiting\"}))"
                  }
                }
              }
            }
          ]
        }
      },
      "widget-4-6": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "",
            "name": ""
          },
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "A drastic change in requests per second can alert you to problems brewing somewhere in your environment."
            }
          },
          "queries": []
        }
      },
      "widget-5-1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "[TIMEPIN] Datadog pinned this widget to its own time frame; Perses and Dash0 panels have no per-panel time range, so it follows the dashboard time picker. Values reduced over that range, including query values and rankings, can change.",
            "name": "Active connections per second"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum (max by (host_name) ({otel_metric_name=\"nginx.connections_current\", otel_metric_type=\"sum\", host_name=~\"^($Host)$\", state=\"active\"}))"
                  }
                }
              }
            }
          ]
        }
      },
      "widget-5-2": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "",
            "name": ""
          },
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "Dropped connections should be at zero. If your rate of dropped connections per unit time starts to rise, look for possible resource saturation."
            }
          },
          "queries": []
        }
      }
    },
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "allowAllValue": true,
          "allowMultiple": true,
          "defaultValue": "$__all",
          "display": {
            "name": "Host"
          },
          "name": "Host",
          "plugin": {
            "kind": "PrometheusLabelValuesVariable",
            "spec": {
              "labelName": "host_name"
            }
          }
        }
      }
    ]
  }
}
